  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-smartglasses/open-smartglasses.git",
    "directory": "packages/lint"
  },
  "homepage": "https://github.com/open-smartglasses/open-smartglasses#readme",
  "bugs": "https://github.com/open-smartglasses/open-smartglasses/issues",
  "keywords": [
    "smart glasses",
    "lint",
    "meta ray-ban display",
    "even realities",
    "even g2",
    "even hub",
    "hud",
    "accessibility"
  ]
