{
  "name": "@open-smartglasses/lint",
  "version": "0.1.0",
  "description": "Checks a smart glasses app on the screen it renders: Meta Ray-Ban Display web apps and Even G2 apps on Even Hub.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "osg-lint": "bin/osg-lint.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "devices",
    "records"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "prepack": "node scripts/pack-data.mjs copy",
    "postpack": "node scripts/pack-data.mjs clean"
  },
  "dependencies": {
    "playwright-core": "^1.50.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
