{
  "name": "@open-smartglasses/lint",
  "version": "0.0.0",
  "description": "Checks a smart glasses app against the Open Smartglasses guidelines.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "osg-lint": "bin/osg-lint.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "devices",
    "records"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "prepack": "node -e \"const fs=require('fs');fs.cpSync('../../data/devices','devices',{recursive:true});fs.cpSync('../../data/records','records',{recursive:true})\""
  },
  "dependencies": {
    "playwright-core": "^1.50.0",
    "pngjs": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-smartglasses/open-smartglasses.git",
    "directory": "packages/lint"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
